# Exibe credenciais fictícias somente no desenvolvimento local.
VITE_DEMO_MODE=false

# Configuração pública embutida no build. Não colocar segredos nestas variáveis.
# O padrão OSM é usado na demonstração. Produção: preferir tiles institucionais.
# VITE_MAP_TILE_URL=https://mapas.exemplo.gov.br/tiles/{z}/{x}/{y}.png
