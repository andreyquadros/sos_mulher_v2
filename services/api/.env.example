HOST=127.0.0.1
PORT=3001
PANEL_ORIGIN=http://127.0.0.1:5173
DATABASE_PATH=./data/mulher-lume.sqlite
# 0 = ignora X-Forwarded-For; configure 1/2 somente em rede de proxies privados controlados.
TRUST_PROXY_HOPS=0
NODE_ENV=development
DEMO_MODE=true
# Demonstração explícita: demo@mulher.ro.gov.br / Lume-Demo-2026!
# Em ambiente institucional: DEMO_MODE=false, NODE_ENV=production e HTTPS no proxy.
